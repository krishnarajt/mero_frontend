# Where the mero backend lives. Set this in the Vercel project (it is baked in
# at build time). Production builds default to this value if it is unset.
# Leave it unset in local dev so Vite proxies /api and /ws to VITE_DEV_API.
VITE_API_BASE_URL=https://mero_backend.krishnarajthadesar.in

# Backend the dev server proxies to. Only used by `npm run dev`.
VITE_DEV_API=http://localhost:1184
